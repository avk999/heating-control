    {
        "id": "362c3fa9ef3fdae8",
        "type": "function",
        "z": "3076cc48ebbebab4",
        "name": "presence -> mode",
        "func": "// topic carries the thermostat, set on each presence node.\nmsg.payload = (msg.payload === \"on\") ? \"heat\" : \"off\";\n\n// Drop a presence-driven 'off' while the zone's pre-heat cron is still ticking.\n// The crons assert heat across their whole window, so an \"off\" here would survive only\n// until the next tick and the two controls would simply alternate. Measured 8 Nov: three\n// such flaps in 31 min stacked the PID integral 0.28 -> 3.27 and cut the boiler command\n// 58 -> 33 with the coldest room 1.5 K short; each flap also slams the valve to 16.\n// The window is inferred from the tick, so the hours live only in the cron expression.\n// Tolerance 900 s against a 300 s tick rate, so three ticks can be missed or delayed\n// before the suppression lapses. The cost is that presence-off stays blocked for up to\n// 15 min after the window's last tick, which only delays the evening release.\nvar seen = flow.get('preheat_tick') || {}\nvar last = seen[msg.topic]\nif (msg.payload === \"off\" && last && Date.now() - last < 900000) {\n    node.warn('presence off for ' + msg.topic + ' ignored: pre-heat cron still ticking')\n    return null\n}\n\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 400,
        "wires": [
            [
                "6bdf02c38888dc3c"
            ]
        ]
    },
