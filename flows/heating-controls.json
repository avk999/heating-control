    {
        "id": "c0ffee26preheat1",
        "type": "function",
        "z": "3076cc48ebbebab4",
        "name": "note preheat tick",
        "func": "// The pre-heat crons tick repeatedly for the whole window, so a recent tick means\n// the window is open. Recorded here so the presence branch can tell, which keeps the\n// hours in the cron expressions and nowhere else.\nif (msg.payload === 'heat') {\n    var seen = flow.get('preheat_tick') || {}\n    seen[msg.topic] = Date.now()\n    flow.set('preheat_tick', seen)\n}\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
